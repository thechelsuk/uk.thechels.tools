---
layout: none
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ "/" | absolute_url }}</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
  </url>
  {%- assign docs = site.tools | concat: site.html_pages %}
  {%- for page in docs %}
  {%- if page.url != "/" and page.sitemap != false and page.noindex != true %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    {%- assign modified = page.last_modified_at | default: page.date %}
    {%- if modified %}
    <lastmod>{{ modified | date: "%Y-%m-%d" }}</lastmod>
    {%- endif %}
  </url>
  {%- endif %}
  {%- endfor %}
</urlset>
